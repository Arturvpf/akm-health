{
  "name": "akm-health-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:navigation": "node scripts/test-navigation.cjs",
    "test:dashboard": "node --test scripts/test-dashboard.cjs",
    "test:registration": "node --test scripts/test-registration.cjs",
    "test:mvp": "node scripts/test-mvp-browser.mjs",
    "test:mvp:install": "playwright-core install chromium --only-shell",
    "test:p2": "node scripts/test-p2-experiments.cjs",
    "test:offline": "node scripts/test-p2-offline.cjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "4.14.0",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vite": "^7.2.0"
  },
  "license": "Apache-2.0"
}
